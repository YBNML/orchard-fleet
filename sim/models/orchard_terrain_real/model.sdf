<?xml version="1.0" ?>
<!-- 자동 생성 (gen_heightmap.py --flat-gentle)
     실사 정사영상 월드용 평탄 지형: 경사 0.00° (방위 0°),
     기복 노이즈 ±2.5 cm. 계단·법면·선회 패드 없음.
     지면 diffuse 는 정사영상을 월드축에 맞춰 재투영한 ground_ortho.png 다
     (farm.json 아핀과 UV 정합 — bake_ortho_texture 참조). -->
<sdf version="1.9">
  <model name="orchard_terrain_real">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><heightmap>
          <uri>model://orchard_terrain_real/materials/textures/orchard_heightmap.png</uri>
          <size>260.0 260.0 0.0299</size><pos>0 0 0</pos>
        </heightmap></geometry>
      </collision>
      <visual name="visual">
        <geometry><heightmap>
          <uri>model://orchard_terrain_real/materials/textures/orchard_heightmap.png</uri>
          <size>260.0 260.0 0.0299</size><pos>0 0 0</pos>
          <!-- texture size = 지형 한 변. Ogre 지형 레이어는 uv = 정규화 월드좌표
               × (지형변/레이어변) 이므로 둘을 같게 두면 이미지 1장이 지형 전체를
               정확히 한 번 덮는다 (반복 없음). -->
          <texture><size>260.0</size>
            <diffuse>model://orchard_terrain_real/materials/textures/ground_ortho.png</diffuse>
            <normal>model://orchard_terrain_real/materials/textures/flat_normal.png</normal>
          </texture>
        </heightmap></geometry>
        <material><ambient>0.62 0.60 0.55 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>10</label></plugin>
      </visual>
    </link>
  </model>
</sdf>
