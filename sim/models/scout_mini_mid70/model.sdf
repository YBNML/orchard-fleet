<?xml version="1.0" ?>
<!--
  AgileX SCOUT MINI + Livox MID-70  (설계서 §5)

  제원 (westonrobot/scout_ros2 스펙 검증):
    본체 0.595 x 0.395 x 0.130 m,  축거 0.452,  윤거 0.490
    휠 반경 0.0875 (직경 175 mm),  휠 폭 0.0852,  질량 ~23 kg
  관성 (재계산 — westonrobot 원본은 Husky 유산으로 40~285배 과대했음):
    휠   m=1.5, 회전축 0.00574, 횡축 0.00378
    섀시 m=20,  Ixx 0.288 Iyy 0.618 Izz 0.850
  구동: gz-sim DiffDrive (gz_ros2_control 아님 — 실제 scout_base 가 독립 노드라서)
  센서: MID-70(gpu_lidar) 단독 + IMU + navsat + 카메라  (설계서 §5.4, D7/D12)

  좌표: base_link 를 섀시 중심의 지면 투영점에 둔다 (z=0 이 지면).
-->
<sdf version="1.9">
  <model name="scout_mini_mid70">

    <!-- ═══════════════ 섀시 ═══════════════ -->
    <link name="base_link">
      <!-- z=0.178 은 westonrobot URDF 규약이다. 이 높이라야 휠 오프셋 -0.0905 가
           휠 중심 z=0.0875(=반경, 접지)와 맞고, 실제 메시도 제 위치에 앉는다. -->
      <pose>0 0 0.178 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>0.288</ixx><iyy>0.618</iyy><izz>0.850</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- 실제 AgileX Scout Mini 메시 (westonrobot/scout_ros2, BSD).
           Blender 4.0.2 에 COLLADA 지원이 없어 변환 없이 .dae 를 그대로 쓴다 —
           gz-common 이 libassimp 로 읽는다 (2026-07-25 로드 확인). -->
      <visual name="chassis">
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_base_link.dae</uri>
        </mesh></geometry>
        <!-- 원본 DAE 에 재질이 전혀 없어(material 0/effect 0/texture 0) 흰색으로
             폴백된다. 실제 Scout Mini 의 도장 금속 차체를 PBR 로 재현한다.
             메시가 단일 지오메트리라 부위별(오렌지 트림 등) 분리 착색은 불가능하다. -->
        <material>
          <ambient>0.13 0.13 0.14 1</ambient>
          <diffuse>0.19 0.19 0.21 1</diffuse>
          <specular>0.35 0.35 0.38 1</specular>
          <pbr><metal>
            <metalness>0.55</metalness>
            <roughness>0.42</roughness>
          </metal></pbr>
        </material>
      </visual>
      <!-- 충돌은 프리미티브 유지 (설계서 §9-1: 시각 메시를 충돌로 쓰면 RTF 붕괴) -->
      <collision name="chassis">
        <pose>0 0 0.008 0 0 0</pose>
        <geometry><box><size>0.595 0.395 0.130</size></box></geometry>
      </collision>
    </link>

    <!-- ═══════════════ 4륜 ═══════════════ -->
    <!-- 윤거 0.490 → ±0.245,  축거 0.452 → ±0.226 -->
    <!-- 매크로 대신 4개를 명시. gz-sim 은 xacro 를 안 쓰므로 SDF 직접 기술 -->

    <!-- 앞 좌 -->
    <link name="front_left_wheel">
      <pose>0.226 0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>
    <!-- 앞 우 -->
    <link name="front_right_wheel">
      <pose>0.226 -0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>
    <!-- 뒤 좌 -->
    <link name="rear_left_wheel">
      <pose>-0.226 0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>
    <!-- 뒤 우 -->
    <link name="rear_right_wheel">
      <pose>-0.226 -0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ═══════════════ 마스트 + MID-70 (D12) ═══════════════ -->
    <!-- 로봇과 같은 방향(틸트 없음), 로봇보다 40cm 높게 z=0.645, 앞면 정렬 x=0.275 -->
    <link name="livox_mast">
      <pose>0.275 0 0.40 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.001</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="mast"><geometry><cylinder><radius>0.02</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.30 0.31 0.33 1</ambient><diffuse>0.42 0.43 0.46 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr><metal><metalness>0.85</metalness><roughness>0.30</roughness></metal></pbr>
        </material></visual>
      <visual name="sensor_body">
        <pose>0 0 0.29 0 0 0</pose>
        <geometry><box><size>0.0627 0.097 0.064</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="livox_mast_joint" type="fixed">
      <parent>base_link</parent><child>livox_mast</child>
    </joint>

    <!-- MID-70 광학 원점: base_link 기준 (0.275, 0, 0.645). 마스트 링크 기준 z=0.29 -->
    <link name="livox_frame">
      <pose>0.275 0 0.645 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <!-- MID-360 상당 gpu_lidar (사용자 승인 교체, 08-03). 수평 360° ·
           수직 -7°~+52°, 480x40 ≈ 19.2k/프레임 (~200k pts/s 사양 상당).
           토픽·프레임은 MID-70 시절 그대로 둔다 — 하류 무수정 교체. -->
      <sensor name="livox_mid70" type="gpu_lidar">
        <topic>livox/points_raw</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan>
            <horizontal><samples>480</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>40</samples><min_angle>-0.1222</min_angle><max_angle>0.9076</max_angle></vertical>
          </scan>
          <range><min>0.05</min><max>90.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="livox_frame_joint" type="fixed">
      <parent>base_link</parent><child>livox_frame</child>
    </joint>

    <!-- ═══════════════ IMU (설계서 §5.4 #2) ═══════════════ -->
    <link name="imu_link">
      <pose>0 0 0.245 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="imu" type="imu">
        <topic>imu</topic>
        <update_rate>200</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent><child>imu_link</child>
    </joint>

    <!-- ═══════════════ NavSat GNSS (설계서 §5.4 #4) ═══════════════ -->
    <link name="navsat_link">
      <pose>-0.20 0 0.60 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="navsat" type="navsat">
        <topic>navsat</topic>
        <update_rate>5</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>
    <joint name="navsat_joint" type="fixed">
      <parent>base_link</parent><child>navsat_link</child>
    </joint>

    <!-- ═══════════════ 수관 촬영 카메라 좌/우 (설계서 §5.4 #5·#6) ═══════════════ -->
    <link name="cam_canopy_left">
      <pose>0.05 0.26 1.20 0 -0.209 1.5708</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="cam_canopy_left" type="camera">
        <topic>cam/left/image</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="cam_left_joint" type="fixed">
      <parent>base_link</parent><child>cam_canopy_left</child>
    </joint>

    <link name="cam_canopy_right">
      <pose>0.05 -0.26 1.20 0 -0.209 -1.5708</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="cam_canopy_right" type="camera">
        <topic>cam/right/image</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="cam_right_joint" type="fixed">
      <parent>base_link</parent><child>cam_canopy_right</child>
    </joint>

    <!-- ═══════════════ 전방 RGB-D (행 진입/이탈 검출, 설계서 §5.4 #7) ═══════════════ -->
    <link name="cam_forward">
      <pose>0.30 0 0.45 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="cam_forward" type="rgbd_camera">
        <topic>cam/forward</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.2</near><far>10</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="cam_forward_joint" type="fixed">
      <parent>base_link</parent><child>cam_forward</child>
    </joint>

    <!-- ═══════════════ 구동 — gz-sim DiffDrive (4WD 스키드스티어) ═══════════════ -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.490</wheel_separation>   <!-- 윤거 (축거 아님) -->
      <wheel_radius>0.0875</wheel_radius>
      <max_linear_velocity>2.7</max_linear_velocity>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- 휠 조인트 상태 발행 -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- ═══════════════ 참값 포즈 (Stage-0 스캐폴드용, 설계서 §7.5) ═══════════════ -->
    <!-- 월드의 dynamic_pose/info 를 브리지하면 ros_gz 의 Pose_V→TFMessage 변환기가
         gz 의 name 필드를 프레임 이름으로 옮기지 않아 frame_id 가 빈 문자열이 된다
         (2026-07-25 실측). PosePublisher 는 header 에 frame_id/child_frame_id 를
         제대로 채워주므로 이쪽을 쓴다. 단계 7 에서 FAST-LIO2 로 갈아끼우면 불필요해진다. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>

  </model>
</sdf>
