<?xml version="1.0" ?>
<!--
  AgileX SCOUT MINI + Livox MID-70  (설계서 §5)

  제원 (westonrobot/scout_ros2 스펙 검증):
    본체 0.595 x 0.395 x 0.130 m,  축거 0.452,  윤거 0.490
    휠 반경 0.0875 (직경 175 mm),  휠 폭 0.0852,  질량 ~23 kg
  관성 (재계산 — westonrobot 원본은 Husky 유산으로 40~285배 과대했음):
    휠   m=1.5, 회전축 0.00574, 횡축 0.00378
    섀시 m=20,  Ixx 0.288 Iyy 0.618 Izz 0.850
  구동: gz-sim DiffDrive (gz_ros2_control 아님 — 실제 scout_base 가 독립 노드라서)
  센서: MID-70(gpu_lidar) 단독 + IMU + navsat + 카메라  (설계서 §5.4, D7/D12)

  좌표: base_link 를 섀시 중심의 지면 투영점에 둔다 (z=0 이 지면).

  ── 상부 하이브리드 (스펙 ④ §3, 2026-08-15) ─────────────────────────────
  마스트(라이다 0.645 m)를 **롤바 아치**로 교체했다. 지상 높이 확정치:
      MID-360 0.80 m (아치 상단 중앙) · D455 0.55 m 하향 12°(시각+프레임만)
      분석 카메라 L/R 0.62 m (아치 다리 측면) · 적재 데크 0.32 m · 경광등 0.44 m
  하류 영향(같이 고쳐야 하는 곳): config/fastlio_mid70.yaml 의 extrinsic_T z,
  map_localizer/ros_sensors 의 **센서기준 z 대역**(지상 0.3~1.5 m 를 뜻하던
  −0.35~0.9 는 라이다가 0.155 m 올라간 만큼 −0.50~0.75 로 옮겨야 같은 대역이다).

  ── 토픽 스코프 (다중 로봇, 2026-08-14) ──────────────────────────────────
  센서·플러그인에 <topic>/<odom_topic>/<tf_topic>/<frame_id>/<child_frame_id> 를
  **일부러 쓰지 않는다.** gz-sim 은 이 태그가 있으면 그 문자열을 리터럴 전역
  토픽으로 쓴다 — 같은 모델을 2대 올리면 /cmd_vel·/odom·/tf·/livox/points_raw 가
  한 토픽에 뒤섞여 두 로봇이 서로의 명령과 점군을 받는다 (2026-08-13 실측).
  비워 두면 gz 가 인스턴스 이름으로 스코프한 기본 토픽을 만든다 (2026-08-14
  실측, gz-sim 8.11 · 2로봇 스모크):

      /model/<로봇>/cmd_vel                        DiffDrive 입력
      /model/<로봇>/odometry                       DiffDrive 오도메트리
      /model/<로봇>/tf                             DiffDrive TF
      /model/<로봇>/pose                           PosePublisher 참값
      /world/<월드>/model/<로봇>/joint_state       휠 조인트
      /world/<월드>/model/<로봇>/link/<링크>/sensor/<센서>/<접미>   센서 일체

  DiffDrive 의 frame_id/child_frame_id 도 비워 둔다 — 그러면 gz 가
  "<로봇>/odom" → "<로봇>/base_link" 로 채워 준다(실측). 다중 로봇 TF 접두가
  여기서 공짜로 나온다. ROS 쪽 이름(/scout0N/…)으로의 환원은
  orchard_sim/gz_topics.py 가 한곳에서 만든다 — 이 표를 고치면 거기도 고칠 것.
-->
<sdf version="1.9">
  <model name="scout_mini_mid70">

    <!-- ═══════════════ 섀시 ═══════════════ -->
    <link name="base_link">
      <!-- z=0.178 은 westonrobot URDF 규약이다. 이 높이라야 휠 오프셋 -0.0905 가
           휠 중심 z=0.0875(=반경, 접지)와 맞고, 실제 메시도 제 위치에 앉는다. -->
      <pose>0 0 0.178 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>0.288</ixx><iyy>0.618</iyy><izz>0.850</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- 실제 AgileX Scout Mini 메시 (westonrobot/scout_ros2, BSD).
           Blender 4.0.2 에 COLLADA 지원이 없어 변환 없이 .dae 를 그대로 쓴다 —
           gz-common 이 libassimp 로 읽는다 (2026-07-25 로드 확인). -->
      <visual name="chassis">
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_base_link.dae</uri>
        </mesh></geometry>
        <!-- 원본 DAE 에 재질이 전혀 없어(material 0/effect 0/texture 0) 흰색으로
             폴백된다. 실제 Scout Mini 의 도장 금속 차체를 PBR 로 재현한다.
             메시가 단일 지오메트리라 부위별(오렌지 트림 등) 분리 착색은 불가능하다. -->
        <material>
          <ambient>0.13 0.13 0.14 1</ambient>
          <diffuse>0.19 0.19 0.21 1</diffuse>
          <specular>0.35 0.35 0.38 1</specular>
          <pbr><metal>
            <metalness>0.55</metalness>
            <roughness>0.42</roughness>
          </metal></pbr>
        </material>
      </visual>
      <!-- 충돌은 프리미티브 유지 (설계서 §9-1: 시각 메시를 충돌로 쓰면 RTF 붕괴) -->
      <collision name="chassis">
        <pose>0 0 0.008 0 0 0</pose>
        <geometry><box><size>0.595 0.395 0.130</size></box></geometry>
      </collision>
    </link>

    <!-- ═══════════════ 4륜 ═══════════════ -->
    <!-- 윤거 0.490 → ±0.245,  축거 0.452 → ±0.226 -->
    <!-- 매크로 대신 4개를 명시. gz-sim 은 xacro 를 안 쓰므로 SDF 직접 기술 -->

    <!-- 앞 좌 -->
    <link name="front_left_wheel">
      <pose>0.226 0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>
    <!-- 앞 우 -->
    <link name="front_right_wheel">
      <pose>0.226 -0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>
    <!-- 뒤 좌 -->
    <link name="rear_left_wheel">
      <pose>-0.226 0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>
    <!-- 뒤 우 -->
    <link name="rear_right_wheel">
      <pose>-0.226 -0.245 0.0875 0 0 0</pose>
      <inertial><mass>1.5</mass>
        <!-- 회전축이 Y 이므로 스핀 관성은 iyy 다. 링크를 -90° 돌려놓고
             iyy 를 스핀값으로 두면 축이 어긋난다 (이전 버전의 오류). -->
        <inertia><ixx>0.00378</ixx><iyy>0.00574</iyy><izz>0.00378</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v">
        <!-- 휠 메시는 로봇 프레임 기준으로 저작돼 있어 링크 원점으로 되돌린다
             (westonrobot URDF 와 동일한 오프셋) -->
        <pose>-0.221 -0.225 0.0925 0 0 0</pose>
        <geometry><mesh>
          <uri>model://scout_mini_mid70/meshes/mini_wheel.dae</uri>
        </mesh></geometry>
        <!-- 고무 타이어: 무광·비금속 -->
        <material>
          <ambient>0.055 0.055 0.06 1</ambient>
          <diffuse>0.085 0.085 0.09 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.92</roughness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="c">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0875</radius><length>0.0852</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ═══════════════ 상부 하이브리드 — 롤바 아치 + 노즈 D455 (스펙 ④ §3) ═══════════════ -->
    <!--
      확정 수치(스펙 ④ Global Constraints, 전부 **지상 높이** = 모델 원점 기준 z):
        · MID-360  = 아치 상단 중앙, 0.80 m   (종전 0.645 m 마스트를 대체)
        · D455     = 노즈 브래킷,   0.55 m, 하향 12°  — ④는 시각 지오메트리 +
                     d455_link 프레임까지. **센서 플러그인은 스펙 ⑤의 몫**이라
                     여기에 <sensor> 를 달지 않는다.
        · 분석 카메라 L/R = 아치 다리 측면 / 앰버 경광등 / 아치 뒤 적재 데크

      x=0.275 는 종전 마스트·라이다의 전후 위치를 **그대로** 물려받은 값이다.
      높이만 0.645→0.80 으로 올린다 — x 까지 옮기면 FAST-LIO2 외부파라미터
      (config/fastlio_mid70.yaml extrinsic_T)와 map_localizer 의 sensor_fwd_m
      (0.275)까지 동시에 흔들려, 이번 태스크의 회귀 표면이 불필요하게 넓어진다.

      자기반사 설계: 아치 크로스바 윗면(0.762)·다리 꼭대기(0.74)·D455 상단
      (0.565)·데크(0.32)·경광등(0.44) 이 **전부 MID-360 하한 원뿔(-7°) 아래**에
      오도록 치수를 잡았다. 하한 원뿔의 높이는 z(d) = 0.80 - d·tan(7°) 이므로
      바(반경 0.022, 반길이 0.235)의 끝에서도 0.769 > 0.762 다. 실측은 리포트
      §자기반사 참조.
    -->
    <link name="sensor_arch">
      <pose>0.275 0 0 0 0 0</pose>
      <inertial><mass>1.2</mass>
        <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.01</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <!-- 롤바 다리 좌/우 (차폭 스팬 0.47 m — 윤거 0.49 m 안쪽) -->
      <visual name="arch_leg_l">
        <pose>0 0.235 0.49 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.38 0.40 0.43 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr><metal><metalness>0.85</metalness><roughness>0.32</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="arch_leg_r">
        <pose>0 -0.235 0.49 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.38 0.40 0.43 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr><metal><metalness>0.85</metalness><roughness>0.32</roughness></metal></pbr>
        </material>
      </visual>
      <!-- 상단 크로스바 (축이 y — roll 90°) -->
      <visual name="arch_top">
        <pose>0 0 0.74 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.47</length></cylinder></geometry>
        <material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.38 0.40 0.43 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr><metal><metalness>0.85</metalness><roughness>0.32</roughness></metal></pbr>
        </material>
      </visual>
      <!-- 다리 밑동 플랜지 -->
      <visual name="arch_foot_l">
        <pose>0 0.235 0.238 0 0 0</pose>
        <geometry><box><size>0.07 0.06 0.016</size></box></geometry>
        <material><ambient>0.18 0.19 0.20 1</ambient><diffuse>0.28 0.29 0.31 1</diffuse></material>
      </visual>
      <visual name="arch_foot_r">
        <pose>0 -0.235 0.238 0 0 0</pose>
        <geometry><box><size>0.07 0.06 0.016</size></box></geometry>
        <material><ambient>0.18 0.19 0.20 1</ambient><diffuse>0.28 0.29 0.31 1</diffuse></material>
      </visual>
      <!-- MID-360 라이저 (크로스바 윗면 0.762 → 센서 밑면 0.771) -->
      <visual name="lidar_riser">
        <pose>0 0 0.7665 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.020</length></cylinder></geometry>
        <material><ambient>0.18 0.19 0.20 1</ambient><diffuse>0.28 0.29 0.31 1</diffuse></material>
      </visual>
      <!-- 분석 카메라 L/R 하우징 (아치 다리 측면) -->
      <visual name="cam_housing_l">
        <pose>0 0.275 0.62 0 0 0</pose>
        <geometry><box><size>0.052 0.034 0.042</size></box></geometry>
        <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material>
      </visual>
      <visual name="cam_housing_r">
        <pose>0 -0.275 0.62 0 0 0</pose>
        <geometry><box><size>0.052 0.034 0.042</size></box></geometry>
        <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material>
      </visual>
      <!-- D455 노즈 브래킷 (아치 앞 0.055 m, 지상 0.25→0.545) -->
      <visual name="d455_bracket_post">
        <pose>0.055 0 0.40 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry>
        <material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.32 0.33 0.35 1</diffuse></material>
      </visual>
      <visual name="d455_bracket_arm">
        <pose>0.055 0 0.5455 0 0.2094 0</pose>
        <geometry><box><size>0.05 0.07 0.012</size></box></geometry>
        <material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.32 0.33 0.35 1</diffuse></material>
      </visual>
    </link>
    <joint name="sensor_arch_joint" type="fixed">
      <parent>base_link</parent><child>sensor_arch</child>
    </joint>

    <!-- ═══════════════ 적재 데크 (아치 뒤) + 앰버 경광등 ═══════════════ -->
    <link name="cargo_deck">
      <pose>-0.06 0 0 0 0 0</pose>
      <inertial><mass>0.8</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="deck_plate">
        <pose>0 0 0.305 0 0 0</pose>
        <geometry><box><size>0.40 0.44 0.018</size></box></geometry>
        <material><ambient>0.46 0.47 0.49 1</ambient><diffuse>0.66 0.67 0.69 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><metalness>0.7</metalness><roughness>0.45</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="deck_rail_rear">
        <pose>-0.19 0 0.339 0 0 0</pose>
        <geometry><box><size>0.018 0.44 0.050</size></box></geometry>
        <material><ambient>0.40 0.41 0.43 1</ambient><diffuse>0.58 0.59 0.61 1</diffuse></material>
      </visual>
      <visual name="deck_post_fl">
        <pose>0.17 0.19 0.272 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.32 0.33 0.35 1</diffuse></material>
      </visual>
      <visual name="deck_post_fr">
        <pose>0.17 -0.19 0.272 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.32 0.33 0.35 1</diffuse></material>
      </visual>
      <visual name="deck_post_rl">
        <pose>-0.17 0.19 0.272 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.32 0.33 0.35 1</diffuse></material>
      </visual>
      <visual name="deck_post_rr">
        <pose>-0.17 -0.19 0.272 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.32 0.33 0.35 1</diffuse></material>
      </visual>
      <!-- 앰버 경광등 — 데크 좌후방. 라이다 하한 원뿔(그 자리에서 0.737) 아래다 -->
      <visual name="beacon_stalk">
        <pose>-0.15 0.16 0.349 0 0 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.070</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.24 0.24 0.26 1</diffuse></material>
      </visual>
      <visual name="beacon_dome">
        <pose>-0.15 0.16 0.412 0 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.056</length></cylinder></geometry>
        <material><ambient>0.55 0.30 0.02 1</ambient><diffuse>1.00 0.62 0.05 1</diffuse>
          <specular>0.8 0.6 0.3 1</specular><emissive>0.45 0.22 0.01 1</emissive></material>
      </visual>
      <visual name="beacon_cap">
        <pose>-0.15 0.16 0.444 0 0 0</pose>
        <geometry><cylinder><radius>0.030</radius><length>0.010</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.24 0.24 0.26 1</diffuse></material>
      </visual>
    </link>
    <joint name="cargo_deck_joint" type="fixed">
      <parent>base_link</parent><child>cargo_deck</child>
    </joint>

    <!-- ═══════════════ D455 (시각 + 프레임만 — 센서 플러그인은 스펙 ⑤) ═══════════════ -->
    <!-- 지상 0.55 m, 하향 12°(pitch +0.2094 rad — gz 에서 양의 pitch 가 하향이다). -->
    <link name="d455_link">
      <pose>0.330 0 0.550 0 0.2094 0</pose>
      <inertial><mass>0.1</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="d455_body">
        <geometry><box><size>0.026 0.124 0.029</size></box></geometry>
        <material><ambient>0.10 0.11 0.12 1</ambient><diffuse>0.17 0.18 0.20 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="d455_lens_l">
        <pose>0.014 0.045 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.02 0.03 0.06 1</ambient><diffuse>0.05 0.07 0.14 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular></material>
      </visual>
      <visual name="d455_lens_c">
        <pose>0.014 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.0060</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.06 0.05 0.02 1</ambient><diffuse>0.14 0.11 0.04 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular></material>
      </visual>
      <visual name="d455_lens_r">
        <pose>0.014 -0.045 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.02 0.03 0.06 1</ambient><diffuse>0.05 0.07 0.14 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular></material>
      </visual>
    </link>
    <joint name="d455_joint" type="fixed">
      <parent>base_link</parent><child>d455_link</child>
    </joint>

    <!-- MID-360 광학 원점: base_link 기준 (0.275, 0, 0.80) — 아치 상단 중앙 -->
    <link name="livox_frame">
      <pose>0.275 0 0.800 0 0 0</pose>
      <visual name="mid360_body">
        <geometry><cylinder><radius>0.0325</radius><length>0.058</length></cylinder></geometry>
        <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.11 0.11 0.13 1</diffuse></material>
      </visual>
      <visual name="mid360_window">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.0330</radius><length>0.020</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.03 1</ambient><diffuse>0.04 0.04 0.06 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular></material>
      </visual>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <!-- MID-360 상당 gpu_lidar (사용자 승인 교체, 08-03). 수평 360° ·
           수직 -7°~+52°, 480x40 ≈ 19.2k/프레임 (~200k pts/s 사양 상당).
           토픽·프레임은 MID-70 시절 그대로 둔다 — 하류 무수정 교체. -->
      <!-- 토픽 미지정 — 파일 머리말 '토픽 스코프' 참조. 실제 점군은
           /world/<월드>/model/<로봇>/link/livox_frame/sensor/livox_mid70/scan/points -->
      <sensor name="livox_mid70" type="gpu_lidar">
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan>
            <horizontal><samples>480</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>40</samples><min_angle>-0.1222</min_angle><max_angle>0.9076</max_angle></vertical>
          </scan>
          <range><min>0.05</min><max>90.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="livox_frame_joint" type="fixed">
      <parent>base_link</parent><child>livox_frame</child>
    </joint>

    <!-- ═══════════════ IMU (설계서 §5.4 #2) ═══════════════ -->
    <link name="imu_link">
      <pose>0 0 0.245 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="imu" type="imu">
        <update_rate>200</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent><child>imu_link</child>
    </joint>

    <!-- ═══════════════ NavSat GNSS (설계서 §5.4 #4) ═══════════════ -->
    <link name="navsat_link">
      <pose>-0.20 0 0.60 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="navsat" type="navsat">
        <update_rate>5</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>
    <joint name="navsat_joint" type="fixed">
      <parent>base_link</parent><child>navsat_link</child>
    </joint>

    <!-- ═══════════════ 수관 촬영(분석) 카메라 좌/우 — 아치 다리 측면 (스펙 ④ §3) ═══════════════ -->
    <!-- 종전 (0.05, ±0.26, 1.20) 는 마스트보다 높은 허공에 떠 있던 자리다.
         상부가 아치로 바뀌면서 실제 마운트 면(다리 측면, 지상 0.62 m)으로 내려왔고,
         낮아진 만큼 수관을 담으려 상향각을 12°→20°(pitch -0.35 rad) 로 키웠다. -->
    <link name="cam_canopy_left">
      <pose>0.275 0.285 0.62 0 -0.35 1.5708</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="cam_canopy_left" type="camera">
        <update_rate>10</update_rate>
        <always_on>0</always_on>
        <!-- always_on=0: 구독자가 없으면 렌더링하지 않는다. 실사 월드는 장면이
             6배라 렌더 스레드가 병목이고, 1920x1080 카메라 4대(2로봇)가 10 Hz 로
             무조건 도는 동안 gpu_lidar 가 10 Hz 를 못 채웠다(2026-08-15 실측).
             cameras:=true 로 브리지가 붙으면 그대로 다시 돈다 — 계약 불변. -->
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="cam_left_joint" type="fixed">
      <parent>base_link</parent><child>cam_canopy_left</child>
    </joint>

    <link name="cam_canopy_right">
      <pose>0.275 -0.285 0.62 0 -0.35 -1.5708</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="cam_canopy_right" type="camera">
        <update_rate>10</update_rate>
        <always_on>0</always_on>
        <!-- always_on=0: 구독자가 없으면 렌더링하지 않는다. 실사 월드는 장면이
             6배라 렌더 스레드가 병목이고, 1920x1080 카메라 4대(2로봇)가 10 Hz 로
             무조건 도는 동안 gpu_lidar 가 10 Hz 를 못 채웠다(2026-08-15 실측).
             cameras:=true 로 브리지가 붙으면 그대로 다시 돈다 — 계약 불변. -->
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="cam_right_joint" type="fixed">
      <parent>base_link</parent><child>cam_canopy_right</child>
    </joint>

    <!-- ═══════════════ 전방 RGB-D (행 진입/이탈 검출, 설계서 §5.4 #7) ═══════════════ -->
    <link name="cam_forward">
      <pose>0.30 0 0.45 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="cam_forward" type="rgbd_camera">
        <update_rate>10</update_rate>
        <always_on>0</always_on>
        <!-- always_on=0: 구독자가 없으면 렌더링하지 않는다. 실사 월드는 장면이
             6배라 렌더 스레드가 병목이고, 1920x1080 카메라 4대(2로봇)가 10 Hz 로
             무조건 도는 동안 gpu_lidar 가 10 Hz 를 못 채웠다(2026-08-15 실측).
             cameras:=true 로 브리지가 붙으면 그대로 다시 돈다 — 계약 불변. -->
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.2</near><far>10</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="cam_forward_joint" type="fixed">
      <parent>base_link</parent><child>cam_forward</child>
    </joint>

    <!-- ═══════════════ 구동 — gz-sim DiffDrive (4WD 스키드스티어) ═══════════════ -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.490</wheel_separation>   <!-- 윤거 (축거 아님) -->
      <wheel_radius>0.0875</wheel_radius>
      <max_linear_velocity>2.7</max_linear_velocity>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- 휠 조인트 상태 발행 -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

    <!-- ═══════════════ 참값 포즈 (Stage-0 스캐폴드용, 설계서 §7.5) ═══════════════ -->
    <!-- 월드의 dynamic_pose/info 를 브리지하면 ros_gz 의 Pose_V→TFMessage 변환기가
         gz 의 name 필드를 프레임 이름으로 옮기지 않아 frame_id 가 빈 문자열이 된다
         (2026-07-25 실측). PosePublisher 는 header 에 frame_id/child_frame_id 를
         제대로 채워주므로 이쪽을 쓴다. 단계 7 에서 FAST-LIO2 로 갈아끼우면 불필요해진다. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>

  </model>
</sdf>
